    "dataset": {
      "name": "mw_disk_outer_gaia",
      "kind": "catalog",
      "source": "gaia",
      "query": {
        "adql": "SELECT TOP 300000\n  g.source_id, g.ra, g.dec, g.parallax, g.parallax_over_error,\n  g.pmra, g.pmdec, g.radial_velocity, g.ruwe,\n  g.phot_g_mean_mag, g.bp_rp, d.r_med_photogeo\nFROM gaiadr3.gaia_source AS g\nJOIN external.gaiaedr3_distance AS d ON g.source_id = d.source_id\nWHERE g.radial_velocity IS NOT NULL\n  AND g.ruwe < 1.4\n  AND g.parallax_over_error > 3\n  AND ABS(g.b) < 25\n  AND d.r_med_photogeo > 3500\nORDER BY g.random_index"
      },
